  "cards": [
    { "dot": "cyan", "title": "Runtime", "items": ["Single local process: pywebview shell + a loopback-only threading HTTP server, no network exposure beyond 127.0.0.1", "Route handlers are plain Python modules called by server.py's do_GET/POST/PUT/DELETE dispatch, not a framework", "Collections & Send also owns folder CRUD (folder_routes.py) — same store, folded in rather than shown as a separate node"] },
    { "dot": "amber", "title": "Persistence", "items": ["Collections, environments, and run history are plain JSON files under the repo working directory, written atomically", "Environment secret values are the one exception — stored in the macOS Keychain via the `security` CLI, never in the JSON files"] },
    { "dot": "rose", "title": "External calls", "items": ["Collections & Send is the only component that reaches the network: the user's configured Target API, and optionally an OAuth2 token endpoint for client_credentials auth", "The Runner Orchestrator drives bulk/CSV runs by calling back into Collections & Send's own request-resolution logic rather than duplicating it"] }
  ]
